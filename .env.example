# Copy to .env for local development. Never commit real values.

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require

# n8n
N8N_HOST=http://localhost:5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace-with-a-random-secret
GENERIC_TIMEZONE=Africa/Cairo

# Model routing
MODEL_PROVIDER=mock
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

# NVIDIA
NVIDIA_API_KEY=replace-me
NVIDIA_MODEL=replace-me

# Hugging Face
HUGGINGFACE_API_TOKEN=replace-me
HUGGINGFACE_MODEL=replace-me

# Data acquisition
APIFY_TOKEN=replace-me
APOLLO_API_KEY=replace-me
PROSPEO_API_KEY=replace-me

# Verification
MILLIONVERIFIER_API_KEY=replace-me

# Optional exports
GOOGLE_SHEETS_SPREADSHEET_ID=replace-me
